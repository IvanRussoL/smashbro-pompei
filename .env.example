# Copiare in .env e sostituire i valori: .env non entra mai in Git.

# Database MySQL: utente dedicato all'app, con permessi solo su questi due database (mai root).
DB_HOST=localhost
DB_PORT=3306
DB_USER=smashbro_app
DB_PASSWORD=una-password
DB_NAME=smashbro_pompei
# Database di prova usato da pytest, ricreato dalle fixture: mai lo stesso di DB_NAME.
DB_NAME_TEST=smashbro_pompei_test

# Chiave per firmare la sessione: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generala-con-python-secrets-token-hex-32

# 1 solo sull'hosting in HTTPS: aggiunge l'header Strict-Transport-Security. In sviluppo lasciare 0.
PRODUZIONE=0
